<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PaymentGateway.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swashbuckle gera a documentação Swagger/OpenAPI automaticamente a partir
         dos nossos Controllers, e nos dá aquela telinha /swagger pra testar a API
         direto do navegador, sem precisar do Postman. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
    <!-- Necessário aqui (mesmo o DbContext morando na Infrastructure) porque as
         ferramentas de linha de comando do EF Core (dotnet ef migrations) exigem
         esse pacote no projeto de inicialização (parâmetro startup-project), não só
         onde o DbContext está definido. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Adiciona suporte a autenticação via JWT (JSON Web Token) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaymentGateway.Application\PaymentGateway.Application.csproj" />
    <ProjectReference Include="..\PaymentGateway.Infrastructure\PaymentGateway.Infrastructure.csproj" />
  </ItemGroup>

</Project>
